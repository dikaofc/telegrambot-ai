# telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# access
BOT_ACCESS_MODE=owner
OWNER_IDS=
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=

# agent
DEFAULT_AGENT=auto
DEFAULT_MODEL=auto
DEFAULT_PROVIDER=9router
AGENT_MAX_RETRIES=5
AGENT_TIMEOUT_MS=1800000

# 9router
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=

# openai compatible
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# xAI
XAI_BASE_URL=https://api.x.ai/v1
XAI_API_KEY=

# anthropic
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=

# ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# custom provider
PROVIDER_NAME=
PROVIDER_BASE_URL=
PROVIDER_API_KEY=
PROVIDER_MODEL=

# knowledge graph harness (Graphify CLI, optional — agent auto-detects)
GRAPHIFY_BIN=graphify

# workspace
WORKSPACE_ROOT=/workspaces
# database — sqlite file path (single node) or postgres URL (scale)
DATABASE_URL=./data/teleagent.db
REDIS_URL=redis://localhost:6379

# sandbox
SANDBOX_ENABLED=true
SANDBOX_RUNTIME=local
SANDBOX_MEMORY=4g
SANDBOX_CPUS=2

# concurrency
MAX_CONCURRENT_RUNS=5

# uploads
MAX_UPLOAD_MB=100
MAX_EXTRACTED_MB=500
MAX_OUTPUT_MB=10

# rate limits
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_RUNS=10
MAX_DAILY_TOKENS=1000000

TELEAGENT_API_KEY=
LOG_LEVEL=info
PORT=49374
