# telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# access
BOT_ACCESS_MODE=owner
OWNER_IDS=
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=

# agent
DEFAULT_AGENT=auto
DEFAULT_MODEL=auto
AGENT_MAX_RETRIES=5
AGENT_TIMEOUT_MS=1800000
# hard per-run limits (one run can never eat the machine)
# AGENT_MAX_STEPS          = max tool/LLM steps per run before verification + honest report
# AGENT_MAX_CONTEXT_CHARS  = character budget for the conversation sent to the model
# AGENT_REPLAN_AFTER       = consecutive failures on the same tool before the plan is revised
AGENT_MAX_STEPS=25
AGENT_MAX_CONTEXT_CHARS=60000
AGENT_REPLAN_AFTER=3

# ── PROVIDER: satu config universal untuk semua ──
# PROVIDER = 9router | openai | xai | anthropic | ollama | custom
# endpoint & model bawaan mengikuti PROVIDER — cukup isi API key.
# contoh 9router (lokal):      PROVIDER=9router   + PROVIDER_API_KEY=<key>
# contoh openai:               PROVIDER=openai    + PROVIDER_API_KEY=sk-...
# contoh xai:                  PROVIDER=xai       + PROVIDER_API_KEY=xai-...
# contoh anthropic:            PROVIDER=anthropic + PROVIDER_API_KEY=sk-ant-...
# contoh ollama (lokal):       PROVIDER=ollama    (+ tanpa key juga jalan)
# contoh endpoint sendiri:     PROVIDER=custom
#                              PROVIDER_BASE_URL=https://example.com/v1
#                              PROVIDER_API_KEY=<key>
#                              PROVIDER_MODEL=<nama-model>
# override endpoint bawaan (mis. 9router di host lain):
#                              PROVIDER_BASE_URL=http://192.168.x.xx:20128/v1
PROVIDER=9router
PROVIDER_BASE_URL=
PROVIDER_API_KEY=
PROVIDER_MODEL=
PROVIDER_MODEL_FALLBACK=cph/cehpoint-ai

# knowledge graph harness (Graphify CLI, optional — agent auto-detects)
GRAPHIFY_BIN=graphify

# workspace
WORKSPACE_ROOT=./workspaces
# database — sqlite file path (single node) or postgres URL (scale)
DATABASE_URL=./data/teleagent.db
REDIS_URL=redis://localhost:6379

# sandbox
SANDBOX_ENABLED=true
SANDBOX_RUNTIME=local
SANDBOX_MEMORY=4g
SANDBOX_CPUS=3

# concurrency
MAX_CONCURRENT_RUNS=5

# uploads
MAX_UPLOAD_MB=100
MAX_EXTRACTED_MB=500
MAX_OUTPUT_MB=10

# rate limits
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_RUNS=60
MAX_DAILY_TOKENS=1000000

# ── API / dashboard ──
# HOST = listen address. Default 127.0.0.1 (loopback only) so a fresh install is
# never exposed to the network. Use 0.0.0.0 in containers / behind a proxy.
# Without TELEAGENT_API_KEY, mutating endpoints (approvals, settings, provider
# config, run control) are only reachable from loopback. Set a key to allow
# remote/dashboard access from other machines.
HOST=127.0.0.1
PORT=49375
TELEAGENT_API_KEY=
LOG_LEVEL=info
