# ============================================================
# TELEGRAM USERBOT
# ============================================================
# Dapatkan di https://my.telegram.org → API development tools
API_ID=12345678
API_HASH=your_api_hash_here
PHONE=+628xxxxxxxxxxx
SESSION_NAME=userbot

# ID numerik akun kamu (lihat dari .me setelah login pertama)
OWNER_ID=0
# atau username tanpa @
# OWNER_USERNAME=myusername

# ============================================================
# AI PROVIDER (9router / OpenAI-compatible)
# ============================================================
# Primary model
AI_BASE_URL=https://9router-vercel-ruddy.vercel.app/v1
AI_API_KEY=your_api_key_here
AI_MODEL=roc/mimo-v2.5-free

# Fallback models (auto-fallback kalau primary gagal/rate-limited)
# Format: name|url|model|apikey (pisah dengan ;)
AI_FALLBACKS=fallback-1|https://9router-vercel-ruddy.vercel.app/v1|roc/laguna-s-2.1-free|your_api_key_here;fallback-2|https://9router-vercel-ruddy.vercel.app/v1|roc/nemotron-3.5-lightning-free|your_api_key_here

# ============================================================
# UPSTASH REDIS (training data dari Colab scraper)
# ============================================================
UPSTASH_REDIS_URL=https://your-db.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_token_here

# ============================================================
# AI BEHAVIOR
# ============================================================
AI_ENABLED_DEFAULT=true
AI_REPLY_IN_GROUPS=false
AI_TOOLS=true
AI_MAX_HISTORY=200
AI_CONTEXT_LIMIT=30
AI_TIMEOUT_MS=30000
AI_COOLDOWN_SECONDS=60

# System prompt kustom (kosongkan pakai default)
# AI_SYSTEM_PROMPT=Kamu adalah {name}...

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
